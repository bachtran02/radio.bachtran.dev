# Copy to .env.development or .env.production and fill in values.
VITE_HLS_BASE=        # Base URL for HLS streams (include protocol, e.g. http://localhost:8888)
VITE_GRAPHQL_BASE=    # Host for GraphQL API, no protocol (e.g. localhost:8080)
VITE_OAUTH_BASE=      # Base URL for Spotify OAuth redirect. Leave empty in production (same-origin via reverse proxy).
